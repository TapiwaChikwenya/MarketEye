# Apply this change in backend/.env.example
# ------------------------------------------
# DELETE the entire "# Email Configuration" block
# (the one with SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD,
#  SMTP_FROM_EMAIL, SMTP_FROM_NAME).
#
# REPLACE with the block below:

# Email (SendGrid HTTP API)
# Create a key at https://app.sendgrid.com/settings/api_keys
# with "Restricted Access" + Mail Send: Full Access.
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
# Must EXACTLY match the address verified under
# Settings -> Sender Authentication -> Single Sender Verification.
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=MarketEye
# Set True only for local validation (request accepted, no delivery).
SENDGRID_SANDBOX_MODE=False

# SPA URL for password reset links (no trailing slash)
FRONTEND_BASE_URL=https://app.yourdomain.com
