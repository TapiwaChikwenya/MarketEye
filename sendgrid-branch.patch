index 0000000..01a4392
--- /dev/null
+++ b/backend/app/services/notifications.py.patch
@@ -0,0 +1,95 @@
+# Apply this change in backend/app/services/notifications.py
+# ----------------------------------------------------------
+# 1. Ensure `import asyncio` is present at the top of the file
+#    (it is in most FastAPI service modules; add it if missing).
+#
+# 2. REMOVE the existing `async def send_email(...)` method body
+#    (the one that uses aiosmtplib / SMTP).
+#
+# 3. REPLACE with the method below. Everything else in the file
+#    (Twilio SMS, Twilio voice call, send_notification dispatcher,
+#    NotificationLog persistence, etc.) stays exactly as-is.
+
+    async def send_email(
+        self,
+        to: str,
+        subject: str,
+        body: str,
+        html: Optional[str] = None,
+    ) -> dict:
+        """
+        Send a transactional email via SendGrid's v3 /mail/send HTTP API.
+
+        Returns:
+            dict with at least {"status": "sent"|"error", "provider": ...}.
+            Never raises - failures are logged and surfaced in the return
+            value so callers (alert workers, password reset) can decide
+            how to handle them.
+        """
+        # Demo mode: no API key configured -> log instead of failing.
+        # This keeps local dev and tests working without SendGrid creds.
+        if not settings.SENDGRID_API_KEY:
+            logger.info(f"[DEMO MODE] Email to {to}: {subject}")
+            return {"status": "sent", "provider": "sendgrid_demo"}
+
+        try:
+            # Lazy import so the dependency is only loaded when needed
+            # and the module can still be imported in test environments
+            # where sendgrid may not be installed.
+            from sendgrid import SendGridAPIClient
+            from sendgrid.helpers.mail import Mail, MailSettings, SandBoxMode
+
+            # Mail() automatically orders MIME parts: plain_text first,
+            # html second - which is exactly what email clients expect.
+            message = Mail(
+                from_email=(settings.SENDGRID_FROM_EMAIL, settings.SENDGRID_FROM_NAME),
+                to_emails=to,
+                subject=subject,
+                plain_text_content=body,
+                html_content=html,
+            )
+
+            # Sandbox mode: request is accepted and validated, but no email
+            # is actually delivered. Off by default - opt in via env.
+            if settings.SENDGRID_SANDBOX_MODE:
+                message.mail_settings = MailSettings(
+                    sandbox_mode=SandBoxMode(enable=True)
+                )
+
+            client = SendGridAPIClient(settings.SENDGRID_API_KEY)
+
+            # The SendGrid SDK is synchronous (uses `requests` internally).
+            # Offload to a worker thread so we don't block FastAPI's loop.
+            # Matches the same pattern used in services/market_data.py.
+            response = await asyncio.to_thread(client.send, message)
+
+            # SendGrid returns 202 Accepted on success.
+            if 200 <= response.status_code < 300:
+                return {
+                    "status": "sent",
+                    "provider": "sendgrid",
+                    "message_id": response.headers.get("X-Message-Id"),
+                    "status_code": response.status_code,
+                }
+
+            # 4xx/5xx: common causes are 401 (bad/revoked API key),
+            # 403 (from-address doesn't match a verified sender),
+            # 429 (rate limit on the free tier).
+            logger.error(
+                "SendGrid returned %s for %s: %s",
+                response.status_code,
+                to,
+                str(response.body)[:500],
+            )
+            return {
+                "status": "error",
+                "provider": "sendgrid",
+                "message": f"SendGrid HTTP {response.status_code}",
+                "status_code": response.status_code,
+            }
+
+        except Exception as e:
+            # Network failures, malformed payload, missing dependency, etc.
+            # Log with traceback but don't propagate - the caller decides.
+            logger.exception(f"SendGrid send failed for {to}: {e}")
+            return {"status": "error", "provider": "sendgrid", "message": str(e)}
